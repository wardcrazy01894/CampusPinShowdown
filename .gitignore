node_modules/
dist/
.env
.env.local
.DS_Store
*.log

# Transient git worktrees created for isolated subagent/reviewer runs.
.claude/worktrees/

# Per-machine Claude Code permission grants. The shared config is
# .claude/settings.json (committed); this one is whatever the local operator
# has allowed for themselves and has no business in a public repo.
.claude/settings.local.json

# JSON reporter output written by `rtk vitest` (the Claude Code RTK hook
# rewrites `npx vitest run` to it). Local-only test results, never committed.
.vitest/

# Geocoder cache for scripts/build-towns.mjs (Nominatim responses). The
# committed artifact is public/towns.json, not this.
data/.nominatim-cache.json

# Local Wrangler state — local D1 SQLite + caches for `npm run worker:dev`.
.wrangler/

# Wrangler local secrets for `wrangler dev` (GH_TOKEN etc.). Never commit.
worker/.dev.vars
.dev.vars
